---
import Layout from '../layouts/Layout.astro';
// worksフォルダの中にあるすべての .md ファイルのデータを自動取得する
const allWorks = Object.values(import.meta.glob('./works/*.md', { eager: true }));
---

<Layout title="秋吉 慧一 | DX推進 & インハウスクリエイター">
	<!-- ヒーローセクション -->
	<section class="fade-in px-6 py-20 max-w-5xl mx-auto md:flex items-center gap-12">
		<div class="md:w-2/3">
			<h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight mb-4">
				秋吉 慧一 <br><span class="text-2xl md:text-3xl font-medium text-slate-500">Keiichi Akiyoshi</span>
			</h1>
			<p class="text-xl text-blue-600 mb-6 font-bold">
				DX推進 & インハウスクリエイター
			</p>
			<p class="text-slate-600 leading-relaxed mb-8 text-lg">
				泥臭い業務課題を、Python/GASによる「自動化プログラム」と、<br class="hidden md:block">
				映像・デザインによる「クリエイティブ」の両面から解決します。
			</p>
		</div>
	</section>

	<!-- About セクション -->
	<section id="about" class="fade-in "bg-white py-20 border-y border-slate-200">
		<div class="max-w-5xl mx-auto px-6">
			<h2 class="text-3xl font-bold mb-8 text-slate-900">About</h2>
			<p class="text-slate-700 leading-loose text-lg">
				現在の職場でインハウス（社内）クリエイター兼DX推進担当として活動しています。<br>
				広報動画の制作やグラフィックデザインといったクリエイティブ業務に加え、現場の事務作業を効率化するためのWebアプリ開発（Python/GAS）や、生成AIを活用した業務改善を自社に導入しています。<br><br>
				デジタル上のシステム構築だけでなく、物理的な立体造形（標本アートやカルトナージュ等）の経験も持ち、手段を問わず「課題を解決するためのモノづくり」を得意としています。
			</p>
		</div>
	</section>

	<!-- Skills セクション -->
	<section id="skills" class="fade-in py-20">
		<div class="max-w-5xl mx-auto px-6">
			<h2 class="text-3xl font-bold mb-10 text-slate-900">Skills</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
					<h3 class="text-xl font-bold mb-3 text-blue-600">Auto & Tool (DX)</h3>
					<ul class="list-disc list-inside text-slate-600 space-y-2">
						<li>Python (業務自動化/アプリ開発)</li>
						<li>Google Apps Script (GAS)</li>
						<li>生成AI活用プロンプト設計</li>
					</ul>
				</div>
				<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
					<h3 class="text-xl font-bold mb-3 text-purple-600">Design & Video</h3>
					<ul class="list-disc list-inside text-slate-600 space-y-2">
						<li>動画編集 (Premiere/社内動画)</li>
						<li>グラフィックデザイン</li>
						<li>UI/UX (社内ツールの画面設計)</li>
					</ul>
				</div>
				<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
					<h3 class="text-xl font-bold mb-3 text-orange-600">Craft & Writing</h3>
					<ul class="list-disc list-inside text-slate-600 space-y-2">
						<li>ハンドクラフト (造形・標本等)</li>
						<li>記事執筆・エッセイ</li>
						<li>カルトナージュ</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Works セクション -->
	<section id="works" class="fade-in py-20 bg-slate-50 border-t border-slate-200">
		<div class="max-w-5xl mx-auto px-6">
			<h2 class="text-3xl font-bold mb-10 text-slate-900">Works</h2>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{allWorks.map((work: any) => (
					<a href={work.url} class="fade-in group block bg-white rounded-2xl overflow-hidden hover:shadow-xl transition duration-300 border border-slate-100 flex flex-col h-full">
						<div class="h-52 bg-slate-200 overflow-hidden relative">
							{work.frontmatter.image ? (
								<picture>
									<source srcset={work.frontmatter.image.replace(/\.(png|jpe?g)$/i, '.avif')} type="image/avif" />
									<img src={work.frontmatter.image} alt={work.frontmatter.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" decoding="async" />
								</picture>
							) : (
								<div class="w-full h-full flex items-center justify-center text-slate-400 bg-slate-100">No Image</div>
							)}
							<span class="absolute top-4 left-4 bg-slate-900/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
								{work.frontmatter.category}
							</span>
						</div>
						<div class="p-6 flex flex-col flex-grow">
							<h3 class="text-lg font-bold mb-3 text-slate-900 group-hover:text-blue-600 transition leading-tight">
								{work.frontmatter.title}
							</h3>
							<p class="text-slate-600 text-sm flex-grow leading-relaxed">
								{work.frontmatter.summary}
							</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
</Layout>