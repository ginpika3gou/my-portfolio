---
import Layout from '../layouts/Layout.astro';
// worksフォルダの中にあるすべての .md ファイルのデータを自動取得する
const allWorks = Object.values(import.meta.glob('./works/*.md', { eager: true }));
---

<Layout title="秋吉 慧一 | DX推進 & インハウスクリエイター">
	<!-- ヒーローセクション -->
	<section class="fade-in px-6 py-20 max-w-5xl mx-auto md:flex items-center gap-12">
		<div class="md:w-2/3">
			<h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight mb-4">
				秋吉 慧一 <br><span class="text-2xl md:text-3xl font-medium text-slate-500">Keiichi Akiyoshi</span>
			</h1>
			<p class="text-xl text-blue-600 mb-6 font-bold">
				DX推進 & インハウスクリエイター
			</p>
			<p class="text-slate-600 leading-relaxed mb-8 text-lg">
				泥臭い業務課題を、Python/GASによる「自動化プログラム」と、<br class="hidden md:block">
				映像・デザインによる「クリエイティブ」の両面から解決します。
			</p>
		</div>
	</section>

	<!-- About セクション（背景を半透明に変更） -->
	<section id="about" class="fade-in bg-white/70 backdrop-blur-sm py-20 border-y border-slate-200">
		<div class="max-w-5xl mx-auto px-6">
			<h2 class="text-3xl font-bold mb-8 text-slate-900">About</h2>
			<p class="text-slate-700 leading-loose text-lg">
				現在の職場でインハウス（社内）クリエイター兼DX推進担当として活動しています。<br>
				広報動画の制作やグラフィックデザインといったクリエイティブ業務に加え、現場の事務作業を効率化するためのWebアプリ開発（Python/GAS）や、生成AIを活用した業務改善を自社に導入しています。<br><br>
				デジタル上のシステム構築だけでなく、物理的な立体造形（標本アートやカルトナージュ等）の経験も持ち、手段を問わず「課題を解決するためのモノづくり」を得意としています。
			</p>
		</div>
	</section>

	<!-- Skills セクション -->
	<section id="skills" class="fade-in py-20">
		<div class="max-w-5xl mx-auto px-6">
			<h2 class="text-3xl font-bold mb-10 text-slate-900">Skills</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				
				<!-- カード1: Auto & Tool -->
				<button data-filter-target="Auto" class="skill-card text-left w-full bg-white/90 backdrop-blur-sm p-6 rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:-translate-y-1 transition duration-300 cursor-pointer">
					<div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
						</svg>
					</div>
					<h3 class="text-xl font-bold mb-3 text-slate-900">Auto & Tool (DX)</h3>
					<ul class="list-disc list-inside text-slate-600 space-y-2">
						<li>Python (業務自動化/アプリ開発)</li>
						<li>Google Apps Script (GAS)</li>
						<li>生成AI活用プロンプト設計</li>
					</ul>
				</button>

				<!-- カード2: Design & Video -->
				<button data-filter-target="Design" class="skill-card text-left w-full bg-white/90 backdrop-blur-sm p-6 rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:-translate-y-1 transition duration-300 cursor-pointer">
					<div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />
						</svg>
					</div>
					<h3 class="text-xl font-bold mb-3 text-slate-900">Design & Video</h3>
					<ul class="list-disc list-inside text-slate-600 space-y-2">
						<li>動画編集 (Premiere/社内動画)</li>
						<li>グラフィックデザイン</li>
						<li>UI/UX (社内ツールの画面設計)</li>
					</ul>
				</button>

				<!-- カード3: Craft & Writing -->
				<button data-filter-target="Craft" class="skill-card text-left w-full bg-white/90 backdrop-blur-sm p-6 rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:-translate-y-1 transition duration-300 cursor-pointer">
					<div class="w-12 h-12 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
						</svg>
					</div>
					<h3 class="text-xl font-bold mb-3 text-slate-900">Craft & Writing</h3>
					<ul class="list-disc list-inside text-slate-600 space-y-2">
						<li>ハンドクラフト (造形・標本等)</li>
						<li>記事執筆・エッセイ</li>
						<li>カルトナージュ</li>
					</ul>
				</button>

			</div>
		</div>
	</section>

	<!-- Works セクション -->
	<section id="works" class="fade-in py-20 border-t border-slate-200 scroll-mt-20">
		<div class="max-w-5xl mx-auto px-6">
			<h2 class="text-3xl font-bold mb-8 text-slate-900">Works</h2>
			
			<!-- 追加：絞り込みタグメニュー -->
			<div class="flex flex-wrap gap-3 mb-10">
				<button class="filter-btn px-5 py-2 rounded-full font-bold text-sm bg-slate-900 text-white transition" data-filter="all">All</button>
				<button class="filter-btn px-5 py-2 rounded-full font-bold text-sm bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition" data-filter="Auto">Auto & Tool</button>
				<button class="filter-btn px-5 py-2 rounded-full font-bold text-sm bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition" data-filter="Design">Design & Video</button>
				<button class="filter-btn px-5 py-2 rounded-full font-bold text-sm bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition" data-filter="Craft">Craft & Art</button>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-4">
				{allWorks.map((work: any) => (
					<a href={work.url} data-category={work.frontmatter.category} class="work-card fade-in group relative bg-white p-3 rounded-lg shadow-md hover:shadow-xl hover:-translate-y-2 hover:-rotate-1 transition duration-300 border border-slate-200 flex flex-col h-full">
						
						<div class="absolute -top-3 left-1/2 -translate-x-1/2 w-24 h-7 bg-amber-200/60 backdrop-blur-sm rotate-[-3deg] z-10 shadow-sm border border-white/40"></div>

						<div class="h-52 bg-slate-200 overflow-hidden relative rounded border border-slate-100">
							{work.frontmatter.image ? (
								<picture>
									<source srcset={work.frontmatter.image.replace(/\.(png|jpe?g)$/i, '.avif')} type="image/avif" />
									<img src={work.frontmatter.image} alt={work.frontmatter.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-700" loading="lazy" decoding="async" />
								</picture>
							) : (
								<div class="w-full h-full flex items-center justify-center text-slate-400 bg-slate-50">No Image</div>
							)}
							<span class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur-md text-white text-xs font-bold px-3 py-1.5 rounded shadow-sm">
								{work.frontmatter.category}
							</span>
						</div>
						<div class="pt-5 pb-3 px-2 flex flex-col flex-grow">
							<h3 class="text-lg font-bold mb-3 text-slate-900 group-hover:text-blue-600 transition leading-tight">
								{work.frontmatter.title}
							</h3>
							<p class="text-slate-600 text-sm flex-grow leading-relaxed">
								{work.frontmatter.summary}
							</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
  
  <script>
		document.addEventListener('DOMContentLoaded', () => {
			const skillCards = document.querySelectorAll('.skill-card');
			const workCards = document.querySelectorAll('.work-card');
			const filterBtns = document.querySelectorAll('.filter-btn');

			// 絞り込みを実行する関数
			function applyFilter(filterKeyword) {
				// 作品カードの表示・非表示を切り替え
				workCards.forEach(card => {
					// html上で定義した dataset.category を取得 (例: "Auto & Tool")
					const category = card.getAttribute('data-category') || '';
					if (filterKeyword === 'all' || category.includes(filterKeyword)) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});

				// タグボタンの見た目（黒/白）を更新
				filterBtns.forEach(btn => {
					if (btn.getAttribute('data-filter') === filterKeyword) {
						btn.classList.add('bg-slate-900', 'text-white');
						btn.classList.remove('bg-white', 'text-slate-600');
					} else {
						btn.classList.add('bg-white', 'text-slate-600');
						btn.classList.remove('bg-slate-900', 'text-white');
					}
				});
			}

			// 1. スキルカードをクリックしたときの処理
			skillCards.forEach(card => {
				card.addEventListener('click', () => {
					const target = card.getAttribute('data-filter-target');
					applyFilter(target);
					// Worksセクションまでスムーズにスクロール
					document.getElementById('works').scrollIntoView({ behavior: 'smooth' });
				});
			});

			// 2. Works上のタグボタンをクリックしたときの処理
			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					applyFilter(btn.getAttribute('data-filter'));
				});
			});
		});
	</script>
</Layout>