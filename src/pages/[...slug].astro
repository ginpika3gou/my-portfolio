---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{work.data.title} | 秋吉 慧一</title>
  </head>
  <body style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem; font-family: sans-serif; line-height: 1.6; color: #333;">
    <a href="/" style="color: #666; text-decoration: none; font-size: 0.9rem;">← トップページに戻る</a>
    
    <main style="margin-top: 2rem;">
      <span style="font-size: 0.8rem; background: #f0f0f0; padding: 0.2rem 0.6rem; border-radius: 4px; color: #555;">{work.data.category}</span>
      <h1 style="font-size: 2rem; margin: 0.8rem 0 0.5rem; line-height: 1.3;">{work.data.title}</h1>
      <time style="font-size: 0.85rem; color: #888;">{work.data.date}</time>
      
      <img src={work.data.image} alt={work.data.title} style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin: 1.5rem 0;" />
      
      <div style="margin-top: 2rem; border-top: 1px solid #eee; padding-top: 1.5rem;">
        <Content />
      </div>
    </main>
  </body>
</html>