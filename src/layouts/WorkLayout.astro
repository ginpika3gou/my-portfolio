---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | Keiichi Akiyoshi`}>
  <article class="max-w-3xl mx-auto px-6 py-24">
    <!-- ヘッダー部分（タイトルや画像） -->
    <div class="mb-10 text-center">
      <span class="bg-blue-100 text-blue-800 text-sm font-bold px-4 py-1.5 rounded-full">
        {frontmatter.category}
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold mt-6 mb-4 text-slate-900 leading-tight">
        {frontmatter.title}
      </h1>
    </div>

    {frontmatter.image && (
      <img 
        src={frontmatter.image} 
        alt={frontmatter.title} 
        class="w-full h-auto rounded-xl mb-12 object-cover" 
        loading="lazy" 
        decoding="async"
      />
    )}

    <!-- 本文が入る部分 -->
    <div class="work-content">
      <slot />
    </div>

    <div class="mt-20 text-center border-t border-slate-200 pt-8">
      <a href="/#works" class="inline-block bg-slate-900 text-white px-8 py-3 rounded-lg font-medium hover:bg-slate-800 transition">
        ← Works一覧へ戻る
      </a>
    </div>
  </article>
</Layout>

<style is:global>
  /* Markdown本文のデザイン設定 */
  .work-content h2 { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-top: 3rem; margin-bottom: 1rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; }
  .work-content h3 { font-size: 1.25rem; font-weight: 700; color: #334155; margin-top: 2rem; margin-bottom: 1rem; }
  .work-content p { color: #475569; margin-bottom: 1.5rem; line-height: 1.8; }
  .work-content ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 1.5rem; color: #475569; }
  .work-content li { margin-bottom: 0.5rem; }
  .work-content a { color: #2563eb; text-decoration: underline; }
  .work-content strong { color: #0f172a; font-weight: 700; }
</style>