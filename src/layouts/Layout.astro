---
import '../styles/global.css'; /* ← これを追加しました */

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-800 font-sans antialiased">
		<!-- ヘッダー -->
		<header class="fixed w-full bg-white/80 backdrop-blur-md shadow-sm z-50">
			<div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
				<a href="/" class="text-xl font-bold tracking-tight text-slate-900">Keiichi Akiyoshi</a>
				<nav class="hidden md:flex gap-6 text-sm font-medium text-slate-600">
					<a href="/#about" class="hover:text-blue-600 transition">About</a>
					<a href="/#skills" class="hover:text-blue-600 transition">Skills</a>
					<a href="/#works" class="hover:text-blue-600 transition">Works</a>
				</nav>
			</div>
		</header>

		<!-- ページの中身（index.astroなどが入る場所） -->
		<main class="pt-24 pb-12 min-h-screen">
			<slot />
		</main>

		<!-- フッター -->
		<footer class="bg-slate-900 py-8 text-center text-slate-400 text-sm">
			<p>&copy; {new Date().getFullYear()} Keiichi Akiyoshi. All rights reserved.</p>
		</footer>
	</body>
</html>